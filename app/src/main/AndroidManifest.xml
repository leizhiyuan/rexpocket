<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- The app downloads a newer build of itself and hands it to the system installer. -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <!-- The Tailscale box reads the phone's interfaces and default network. -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- Background alerts: the notifications, and the foreground service that keeps the connection up. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <!-- Background mode: starts again after a reboot, and asks to be left out of battery
         optimization (the app comes from its GitHub releases, not a store that restricts this). -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />
    <!-- A bell in the pane on screen buzzes, as the system's notification vibration allows. -->
    <uses-permission android:name="android.permission.VIBRATE" />
    <!-- No backup and no device-to-device copy: the tailnet node's key would come back on a second
         phone (two devices sharing one node), and the Keystore-wrapped secrets could not be decrypted
         there. Hosts and settings move with the app's own export instead. -->
    <application
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.RexPocket"
        android:usesCleartextTraffic="true">
        <activity
            android:name=".MainActivity"
            android:configChanges="keyboard|keyboardHidden|orientation|screenSize|screenLayout|smallestScreenSize"
            android:exported="true"
            android:launchMode="singleTop"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- A long press on one of the app's Quick Settings tiles: its host's or tailnet's page. -->
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE_PREFERENCES" />
            </intent-filter>
            <!-- A host to add: rexpocket://add?addr=...&name=..., tapped as a link or read from a
                 QR code by the phone's camera app. It opens Add host filled in; only Save saves. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="rexpocket" android:host="add" />
            </intent-filter>
        </activity>
        <!-- Share into RexPocket: text is pasted, images and other files uploaded, after a tap. -->
        <activity
            android:name=".ShareActivity"
            android:excludeFromRecents="true"
            android:exported="true"
            android:label="@string/share_target"
            android:noHistory="true"
            android:taskAffinity=""
            android:theme="@android:style/Theme.Translucent.NoTitleBar">
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <action android:name="android.intent.action.SEND_MULTIPLE" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/*" />
                <data android:mimeType="image/*" />
                <data android:mimeType="*/*" />
            </intent-filter>
            <!-- "Open with": a rexpocket-hosts/1 file goes to Import hosts, which shows it before anything changes. -->
            <intent-filter android:label="@string/import_open_with">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:scheme="content" />
                <data android:mimeType="application/json" />
            </intent-filter>
        </activity>
        <!-- The diagnostics report is written to the cache and handed out one file at a time. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/diagnostic_paths" />
        </provider>
        <!-- A notification's Reply and Interrupt; only the app's own notifications reach it. -->
        <receiver
            android:name=".alerts.AlertActionReceiver"
            android:exported="false" />
        <!-- Background mode after a reboot or an update; not direct-boot aware, see BootReceiver. -->
        <receiver
            android:name=".alerts.BootReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.QUICKBOOT_POWERON" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>
        <!-- Quick Settings: a pool of three tiles, each bound to a host or a tailnet the person picks
             (tile services are declared here, so there cannot be one per host). A long press on one
             opens MainActivity's QS_TILE_PREFERENCES filter: that host's or tailnet's page. -->
        <activity
            android:name=".alerts.TilePickerActivity"
            android:excludeFromRecents="true"
            android:exported="false"
            android:noHistory="true"
            android:taskAffinity=""
            android:theme="@android:style/Theme.Translucent.NoTitleBar" />
        <service
            android:name=".alerts.RexTile1"
            android:exported="true"
            android:icon="@drawable/ic_tailnet"
            android:label="@string/tile_label"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>
        <service
            android:name=".alerts.RexTile2"
            android:exported="true"
            android:icon="@drawable/ic_host"
            android:label="@string/tile_label"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>
        <service
            android:name=".alerts.RexTile3"
            android:exported="true"
            android:icon="@drawable/ic_host"
            android:label="@string/tile_label"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>
        <!-- Background mode's own tile: on and off, apart from the pool of three above. A long press
             opens MainActivity's QS_TILE_PREFERENCES filter: Settings › Background and notifications. -->
        <service
            android:name=".alerts.BackgroundTile"
            android:exported="true"
            android:icon="@drawable/ic_notifications"
            android:label="@string/tile_background_label"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
            <meta-data
                android:name="android.service.quicksettings.TOGGLEABLE_TILE"
                android:value="true" />
        </service>
        <!-- The home screen widget: what needs you, what is done and what works, per host. -->
        <receiver
            android:name=".alerts.HomeWidgetReceiver"
            android:exported="true"
            android:label="@string/widget_name">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/home_widget_info" />
        </receiver>
        <service
            android:name=".alerts.WatchService"
            android:exported="false"
            android:foregroundServiceType="specialUse"
            android:stopWithTask="false">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Keeps the connections to the user's own Rex terminal servers open while the app is in the background, and after a restart when the user turned background mode on, to notify when a program in a terminal is waiting for the user." />
        </service>
    </application>
</manifest>

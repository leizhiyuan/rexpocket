# The Rex server the real-Rex tests run against: the one place to bump it.
#
# Rex is Superlogical's, and proprietary: CI fetches it from Superlogical's own apt repository at
# run time, checks it against these values, and never stores or uploads it.
#
# To move to a newer preview: look up its Version and SHA256 for amd64 in
#   https://pkgs.superlogical.com/rex/apt/dists/preview/main/binary-amd64/Packages
# put them here, and run the real-Rex tests (docs/design/testing.md). A changed shape fails
# RexShapeTest against the new Rex; record the new shapes with REX_RECORD_SHAPES=1 and bring
# ScriptedRex in line. REX_VERSION_OUTPUT and REX_API_REVISION are what `rex version` must print.
REX_APT_URL=https://pkgs.superlogical.com/rex/apt
REX_APT_SUITE=preview
REX_KEYRING_URL=https://pkgs.superlogical.com/rex/keys/rex-archive-keyring.gpg
REX_KEY_FINGERPRINT=E28636AC71905C6DDE40C1EDFAA6B80F641307A7
REX_VERSION=0.1.0~preview.22
REX_SHA256_AMD64=e2d89c97a7c2e4609f08f2389576eff8b67a644f9187e320f896389ccdced475
REX_VERSION_OUTPUT="rex 0.1.0-preview.22"
REX_API_REVISION=19
